# 데이터 (원천 ~350MB, 커밋 금지)
data/
*.csv
*.tsv
*.txt
*.xlsx
*.xls
*.feather
*.pkl
*.h5
*.db
*.sqlite3
*.zip
*.7z
*.tar.gz

# 문서용 텍스트는 예외
!README.md
!requirements.txt
!backend/requirements.txt
!outputs/tables/*.csv
backend/data/

# ---- 산출물 ----
# outputs/ 는 커밋한다 (EDA 결과·표 공유용). 무거운 중간 산출물만 제외.
outputs/**/*.pkl
preprocessed/sgis_grid.parquet
preprocessed/cell_grid_map.parquet
preprocessed/card2_clean.parquet
submissions/
models/
reports/*.html
*.log
agent/out/runs/
!agent/out/examples/**/*.txt

