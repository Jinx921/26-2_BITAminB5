# 백엔드 주소 (FastAPI). 저장소 루트에서 `uvicorn backend.app.main:app --reload` 로 띄우면 8000번
VITE_API_BASE_URL=http://127.0.0.1:8000

# true 면 백엔드 없이 목업 데이터로 전 화면이 동작한다. false 면 실제 API 호출
VITE_USE_MOCK=true

# 격자·시설 GeoJSON 파일 위치. 기본은 frontend/public/geo (정적 파일).
# 백엔드가 정적 서빙을 시작하면 예: http://127.0.0.1:8000/static/geo 로 바꾼다
VITE_GEO_BASE_URL=/geo
